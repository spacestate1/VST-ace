# Build output. `build/` matches the top-level one and gui/build, peload/build
# with it -- every one of them is produced by `dw build`.
build/
*.o
*.a
*.so
*.so.*
compile_commands.json
# The launcher itself, built from c/src/dw.c.
/dw

# Editor and tooling caches.
.cache/
__pycache__/
*.pyc

# The Ghidra workspace: 104 MB of database that is regenerated by opening the
# binary, and useless to anyone else's Ghidra install.
project/

# Analysis output -- decompiler dumps, string and RTTI listings, disassembly,
# extracted resources and spectra. All derived from binaries by scripts/ and
# tools/, all regenerable, 43 MB. It is also decompiled commercial software,
# which is the more important reason not to publish it.
out/

# Rendered audio, reproducible from patches/ -- including the seven UI sounds,
# whose hand-written definitions live in patches/tuned/machines.py.
renders/

# Not ours to redistribute: a Microsoft redistributable that pehost looks for at
# runtime (see pehost.c), and a vendored LLVM libc++ package. Neither is
# referenced by any build file; see HANDOFF-2026-08-01-msvcp120.md for how to
# put msvcp120.dll back on a working copy.
runtime/
peload/thirdparty/

# Local Claude Code permissions, per-machine.
.claude/settings.local.json

# A stale copy of the loader left in the source directory before the build moved
# under peload/build.
/peload/peload

# The staging directories a package build configures cmake into.
obj-*/

# build-deb.sh writes the .deb, .ddeb, .changes and .buildinfo here. None of it
# belongs in git -- binaries in source control are how a project gets banned
# from GitHub for abuse -- so this is where the releases page's assets come
# from instead, built fresh from a tag rather than committed.
release/
