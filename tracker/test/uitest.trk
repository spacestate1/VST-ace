# The song the window tests (tracker-uitest, tracker-gtk-uitest) open: track 1 goes to
# a client that is running (aseqdump, started by run-uitests.sh), track 3 to one that is not.
tracker 1
bpm 120
lpb 4
track 1 channel 1 velocity 100 mute 0
track 1 name Bass
track 1 client aseqdump
track 1 port aseqdump
track 2 channel 1 velocity 90 mute 0
track 2 name Lead
track 2 client pestudio 2
track 2 port pestudio in
track 3 channel 1 velocity 100 mute 0
track 3 name Track 3
track 3 client not-open-yet
track 3 port nothing
track 4 channel 1 velocity 100 mute 0
track 4 name Track 4
track 5 channel 1 velocity 100 mute 0
track 5 name Track 5
track 6 channel 1 velocity 100 mute 0
track 6 name Track 6
track 7 channel 1 velocity 100 mute 0
track 7 name Track 7
track 8 channel 1 velocity 100 mute 0
track 8 name Track 8
order 0 0 1 1
pattern 0 rows 16
cell 0 0 1 C-2 .. .. ..
cell 0 0 2 C-4 64 .. ..
cell 0 2 2 D#4 50 .. ..
cell 0 3 1 === .. .. ..
cell 0 3 2 === .. .. ..
cell 0 4 1 C-2 .. .. ..
cell 0 6 2 G-4 .. .. ..
cell 0 7 1 === .. .. ..
cell 0 8 1 D#2 .. .. ..
cell 0 8 2 A#4 .. .. ..
cell 0 11 1 === .. .. ..
cell 0 11 2 === .. .. ..
cell 0 12 1 G-2 .. .. ..
cell 0 12 2 G-4 .. .. ..
cell 0 14 2 F-4 .. .. ..
cell 0 15 1 === .. .. ..
pattern 1 rows 16
cell 1 0 1 F-2 .. .. ..
cell 1 0 2 F-4 .. .. ..
cell 1 3 1 === .. .. ..
cell 1 4 1 F-2 .. .. ..
cell 1 4 2 G#4 .. .. ..
cell 1 7 1 === .. .. ..
cell 1 8 1 G-2 .. .. ..
cell 1 8 2 C-5 .. .. ..
cell 1 11 1 === .. .. ..
cell 1 12 1 G-2 .. .. ..
cell 1 12 2 A#4 .. .. ..
cell 1 15 1 === .. .. ..
cell 1 15 2 === .. .. ..
